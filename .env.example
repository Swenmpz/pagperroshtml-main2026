# ------------------------------------------------------------------
#  Plantilla de variables de entorno (copia a ".env" y rellena)
#  El archivo .env está en .gitignore: nunca se sube a GitHub.
# ------------------------------------------------------------------

# Project URL de Supabase:  Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon / publishable):  Supabase > Project Settings > API Keys
# Es segura para el navegador SIEMPRE que el Row Level Security esté activo.
SUPABASE_ANON_KEY=tu_anon_key_aqui